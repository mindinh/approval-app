# Copy to .env.local (git-ignored) and fill in. Restart `npx expo start` after changes.
# These values are bundled into the app: never put secrets (client secret, passwords) here.

# Microsoft Entra ID → app registration → Overview
EXPO_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# App registration → Expose an API → scope
EXPO_PUBLIC_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# BFF reachable from the phone (PC LAN IP, backend port 4005)
EXPO_PUBLIC_API_URL=http://192.168.1.20:4005/api/cnma/APPROVAL_SRV
