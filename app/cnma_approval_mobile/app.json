{
  "expo": {
    "name": "My Approval",
    "slug": "cnma_approval_mobile",
    "owner": "minhdinh03s-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon-sap.png",
    "scheme": "cnmaapproval",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.conarum.prorequests4h",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon-sap.png",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-sap-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.conarum.prorequests4h"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-proconarum.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#181A1E",
            "image": "./assets/images/splash-proconarum.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "My Approval uses Face ID to unlock the app so only you can see and approve requests."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "52720743-2ccd-4a0a-afb4-bb2141c08854"
      }
    }
  }
}
