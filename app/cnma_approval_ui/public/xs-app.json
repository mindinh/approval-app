{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 28800,
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/logout-page.html"
  },
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.default",
      "target": "/odata/v4/$1",
      "destination": "cnma_prorequest_s4h_destination",
      "csrfProtection": false
    },
    {
      "source": "^/api/cnma/(.*)$",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.default",
      "target": "/api/cnma/$1",
      "destination": "cnma_prorequest_s4h_destination",
      "csrfProtection": false
    },
    {
      "source": "^/api/inbox/(.*)$",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.default",
      "target": "/api/inbox/$1",
      "destination": "cnma_prorequest_s4h_destination",
      "csrfProtection": false
    },
    {
      "source": "^/(sw\\.js|startup(?:-recovery)?\\.(?:js|css))$",
      "target": "/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/(logout-page\\.html|web-manifest\\.json|sap-.*\\.png|RESOURCE_FAVICON\\.png)$",
      "target": "/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none",
      "cacheControl": "no-cache"
    },
    {
      "source": "^/index.html$",
      "target": "/index.html",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.default",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.default"
    }
  ],
  "responseHeaders": [
    {
      "name": "X-Frame-Options",
      "value": "SAMEORIGIN"
    }
  ]
}
