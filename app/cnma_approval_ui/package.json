        "framer-motion": "^12.29.2",
        "i18next": "^25.7.3",
        "i18next-browser-languagedetector": "^8.2.0",
        "lucide-react": "0.487.0",
        "radix-ui": "^1.6.0",
        "react": "^18.3.1",
